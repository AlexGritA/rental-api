{
  "info": {
    "name": "Rental API – Fulköpings Uthyrnings AB",
    "description": "Testsamling för Rental API. Kör hela samlingen i ordning med Collection Runner. Kräver att appen och Postgres (docker compose up -d) är igång.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{adminUser}}", "type": "string" },
      { "key": "password", "value": "{{adminPass}}", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Sätter datum relativt dagens datum så att testerna alltid fungerar",
          "const fmt = d => d.toISOString().slice(0, 10);",
          "const addDays = n => { const d = new Date(); d.setDate(d.getDate() + n); return fmt(d); };",
          "pm.collectionVariables.set('startDate', addDays(1));",
          "pm.collectionVariables.set('endDate', addDays(5));",
          "pm.collectionVariables.set('pastDate', addDays(-10));",
          "pm.collectionVariables.set('pastEndDate', addDays(-5));"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminUser", "value": "admin" },
    { "key": "adminPass", "value": "admin123" },
    { "key": "userUser", "value": "user" },
    { "key": "userPass", "value": "user123" },
    { "key": "itemId", "value": "" },
    { "key": "personId", "value": "" },
    { "key": "secondPersonId", "value": "" },
    { "key": "rentalId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Items",
      "item": [
        {
          "name": "Skapa item (ADMIN) → 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Item har fått ett id', () => pm.expect(json.id).to.be.a('number'));",
                  "pm.collectionVariables.set('itemId', json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grävmaskin CAT 320\",\n  \"description\": \"20-tons grävmaskin för större markarbeten\",\n  \"category\": \"Maskiner\",\n  \"pricePerDay\": 2500.00\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/items", "host": ["{{baseUrl}}"], "path": ["api", "items"] }
          }
        },
        {
          "name": "Hämta alla items (USER) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Svaret är en lista', () => pm.expect(pm.response.json()).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{userUser}}", "type": "string" },
                { "key": "password", "value": "{{userPass}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/items", "host": ["{{baseUrl}}"], "path": ["api", "items"] }
          }
        },
        {
          "name": "Hämta item via id → 200",
