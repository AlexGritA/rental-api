            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Grävmaskin CAT 320 XL\",\n  \"description\": \"Uppgraderad med längre arm\",\n  \"category\": \"Maskiner\",\n  \"pricePerDay\": 2900.00\n}",
